#!/bin/sh
set -e

usage() { echo "usage: send <channel> [message-file]" >&2; exit 1; }

CHANNEL="$1"
[ -n "$CHANNEL" ] || usage
shift
[ $# -le 1 ] || usage

BUS="${AGENT_BUS_DIR:-$HOME/.agent-bus}/$CHANNEL"
mkdir -p "$BUS/inbox" "$BUS/tmp"
touch "$BUS/queue.log"

NAME="$(date +%s)-$$.md"

if [ $# -eq 1 ]; then
  cat "$1" > "$BUS/tmp/$NAME"
else
  cat > "$BUS/tmp/$NAME"
fi

mv "$BUS/tmp/$NAME" "$BUS/inbox/$NAME"
echo "$NAME" >> "$BUS/queue.log"
echo "sent: $NAME"
