#!/bin/sh
set -e

CHANNEL="$1"
[ -n "$CHANNEL" ] || { echo "usage: watch <channel>" >&2; exit 1; }

BUS="${AGENT_BUS_DIR:-$HOME/.agent-bus}/$CHANNEL"
mkdir -p "$BUS/inbox" "$BUS/tmp"
touch "$BUS/queue.log" "$BUS/seen"

# Delay each newly arriving id by a random 0..AGENT_BUS_JITTER seconds
# so agents woken by the same message do not hit their APIs in the
# same instant. Needs no cross-host coordination. Replayed history is
# emitted immediately. 0 disables.
JITTER="${AGENT_BUS_JITTER:-10}"

# Replay existing history at once.
cat "$BUS/queue.log"
n=$(wc -l < "$BUS/queue.log" | tr -d ' ')

# Follow by polling the line count. tail -F into a pipe can stall on
# stdio block-buffering, so it is deliberately not used here.
while :; do
  m=$(wc -l < "$BUS/queue.log" | tr -d ' ')
  if [ "$m" -gt "$n" ]; then
    tail -n "$((m - n))" "$BUS/queue.log" | while IFS= read -r id; do
      if [ "$JITTER" != 0 ]; then
        sleep "$(od -An -N2 -tu2 /dev/urandom |
                 awk -v j="$JITTER" 'NR==1{printf "%.2f", $1/65536*j; exit}')"
      fi
      printf '%s\n' "$id"
    done
    n=$m
  fi
  sleep 1
done
